node_modules/
dist/
web/dist/
*.tgz
.DS_Store
*.log
coverage/
.env
.env.*
*.schem
*.litematic
*.glb
*.png
# But include bundled texture assets and docs images
!textures/**/*.png
!textures/*.png
!docs/images/*.png
!web/public/comparison/*.jpg
test-*.sh
test-*.cjs
test-*.txt
audit*
showcase/
bunfig.toml

# Downloaded LEGO model files from seymouria.pl (~400MB, not committed)
data/

# LEGO thumbnails (large binary cache — run: bun run scrape:lego-thumbs)
web/public/lego-thumbs/
# LEGO catalog JSON (regenerated — run: bun run prebuild:lego)
web/public/lego-catalog.json

# Agent subagent worktrees — transient
.claude/worktrees/

# Test/dev LDraw model fixtures kept locally for renderer testing — not
# part of the app or production bundle. Drop new ones into web/public/
# for quick fetch('/<name>.ldr') access during development.
web/public/*.ldr
web/public/*.mpd
web/public/*.io
web/public/*.lxf

# Python bytecode caches (research scripts)
__pycache__/
*.pyc

# pdf-recon research artifacts written beside the scripts by their own tests
scripts/pdf-recon/output/

# Browser-automation downloads and base64 screenshot dumps left by agent sessions
.playwright-mcp/
cap-*.txt

# Generated analysis / experiment output. The subtrees below are deliberately
# tracked (reports, the PDF universal-parts data, comparison + tiles fixtures);
# everything else under output/ is a private run artifact. Adding a new file to
# an ignored path needs `git add -f`.
output/*
!output/*.md
!output/*.html
!output/comparison/
!output/pdf-placement-diagnosis/
!output/pdf-universal-parts/
!output/tiles/
# output/tiles/ is also every local capture's renders + GLBs (1 GB+ on a dev
# box); only the review pages and their small index/state JSON are tracked.
output/tiles/*
!output/tiles/*.html
!output/tiles/grade-index.json
!output/tiles/iterate-state.json

# Pipeline state + per-slug verification reports are tracked (the Stop hook and
# the handoff docs read them); the heavy per-slug artifacts (.glb/.schem/
# .litematic/renders) beside them stay private. Hand-edited pipeline inputs too.
!output/pipeline-state.json
!output/polygon-overrides.json
!output/goldens.json
!output/category-state.json
!output/pipeline/
output/pipeline/**
!output/pipeline/*.verification.json
# One-off QA builds (--slug <x>-qa) are scratch, not golden state.
output/pipeline/*-qa.verification.json
